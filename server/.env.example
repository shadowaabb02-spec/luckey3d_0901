# 复制为 .env 后，在等号右侧自行粘贴 OpenCode Go API Key；不要提交该文件。
OPENCODE_GO_API_KEY=

# OpenCode Go 的 OpenAI-compatible Chat Completions 地址。
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# 默认选用适配 Chat Completions 的快速模型；可改为 OpenCode Go 当前支持的其他 chat/completions 模型。
OPENCODE_GO_MODEL=glm-5.3-flash

# 本地网页开发服务器的允许来源；多个地址用逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# 公网演示必须设置访问码，并要求浏览器请求带允许的 Origin。
EXPERT_GATEWAY_ACCESS_TOKEN=
EXPERT_RATE_LIMIT_PER_MINUTE=12
REQUIRE_ORIGIN=false
EXPERT_GATEWAY_MODE=local_only

# 网关只绑定到本机回环地址，避免 LAN 暴露。
EXPERT_GATEWAY_HOST=127.0.0.1
EXPERT_GATEWAY_PORT=8787
